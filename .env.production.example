# Copie para .env.production e preencha. NUNCA versione o arquivo preenchido.
#
#   cp .env.production.example .env.production
#
# A aplicação se recusa a subir se alguma coisa aqui estiver frouxa — segredo
# curto, cookie inseguro, CORS http:// ou SMTP ausente. É de propósito: falha
# de configuração precisa ser barulhenta na hora, não silenciosa em produção.

# ---------------------------------------------------------------- domínio
# O DNS deste domínio precisa apontar para o IP da máquina ANTES de subir:
# o Caddy pede o certificado no primeiro start e falha se o domínio não resolve.
DOMINIO=rastro.seudominio.com.br
# Usado pelo Let's Encrypt para avisar sobre renovação com problema.
ACME_EMAIL=voce@seudominio.com.br

# ------------------------------------------------------------------ banco
POSTGRES_USER=rastro
POSTGRES_DB=rastro
# Gere com: openssl rand -base64 32
POSTGRES_PASSWORD=

# --------------------------------------------------------------- segurança
# Quem tem esta chave forja um token de administrador.
# Gere com: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# ------------------------------------------------------------ conta inicial
# Criada na primeira subida. Se ADMIN_SENHA ficar vazia, uma senha é sorteada
# e aparece no log uma única vez — em produção, prefira defini-la aqui.
ADMIN_EMAIL=voce@seudominio.com.br
ADMIN_SENHA=

# ------------------------------------------------------------------ e-mail
# Obrigatório em produção: sem SMTP, quem esquecer a senha perde a conta.
#
# Qualquer provedor serve. Alguns com plano gratuito suficiente para começar:
#   Brevo        smtp-relay.brevo.com:587
#   Resend       smtp.resend.com:587
#   Mailgun      smtp.mailgun.org:587
#   Gmail        smtp.gmail.com:587  (exige senha de app, não a senha da conta)
SMTP_HOST=
SMTP_PORTA=587
SMTP_USUARIO=
SMTP_SENHA=
SMTP_REMETENTE=Rastro <nao-responda@seudominio.com.br>
# starttls (587) | ssl (465) | nenhuma
SMTP_SEGURANCA=starttls

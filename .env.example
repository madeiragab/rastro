# Copie para .env e ajuste. Os valores abaixo são os defaults de desenvolvimento.
# O arquivo .env está no .gitignore — nunca versione segredo.

# desenvolvimento | producao
AMBIENTE=desenvolvimento

POSTGRES_USER=rastro
POSTGRES_PASSWORD=rastro
POSTGRES_DB=rastro
POSTGRES_PORT=5432

API_PORT=8000
WEB_PORT=5173

# ---------------------------------------------------------------- segurança
# Chave de assinatura dos access tokens. Quem tem esta chave forja um token de
# administrador. Gere a sua com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Em AMBIENTE=producao a aplicação se recusa a subir com o valor de exemplo.
SECRET_KEY=dev-inseguro-nao-usar-fora-da-sua-maquina

# true obriga HTTPS nos cookies de sessão. Obrigatório em produção.
COOKIE_SECURE=false

# Conta criada na primeira subida. Se ADMIN_SENHA ficar vazia, uma senha
# aleatória é sorteada e aparece no log da API uma única vez.
ADMIN_EMAIL=produtor@rastro.com.br
ADMIN_SENHA=

# Simulador de rebanho. Precisa ser false em produção.
SIMULATOR_ENABLED=true

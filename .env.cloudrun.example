# Variáveis da API no Cloud Run (use com: gcloud run deploy --env-vars-file).
# Formato YAML: CHAVE: "valor". NUNCA versione o arquivo preenchido.
AMBIENTE: "producao"
AUTH_MODO: "firebase"
FIREBASE_PROJETO_ID: "SEU-PROJETO"

# Banco Postgres com PostGIS (Cloud SQL, Neon, Supabase...).
# Cloud SQL via socket:  postgresql+psycopg://rastro:SENHA@/rastro?host=/cloudsql/PROJETO:REGIAO:INSTANCIA
DATABASE_URL: "postgresql+psycopg://USUARIO:SENHA@HOST:5432/rastro?sslmode=require"

# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY: ""

# Site no Hosting + app Android (que roda em https://localhost).
CORS_ORIGINS: '["https://SEU-PROJETO.web.app","https://SEU-PROJETO.firebaseapp.com","https://localhost"]'
APP_URL: "https://SEU-PROJETO.web.app"
COOKIE_SECURE: "true"
SIMULATOR_ENABLED: "false"

# Conta do dono criada na primeira subida (também no Firebase Auth).
ADMIN_EMAIL: "voce@seudominio.com.br"
ADMIN_SENHA: ""

# Copie para frontend/.env.production.local e preencha com os dados do app WEB
# do seu projeto (Console do Firebase > Configurações do projeto > Seus apps).
# Estes valores NÃO são segredo — vão embutidos no JavaScript de qualquer app
# Firebase. A proteção vem das regras do Firebase Auth e da própria API.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=SEU-PROJETO.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=SEU-PROJETO
VITE_FIREBASE_STORAGE_BUCKET=SEU-PROJETO.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Só para o APK: endereço completo da API. No site (Firebase Hosting) deixe
# vazio — lá o /api é reescrito para o Cloud Run na mesma origem.
# VITE_API_URL=https://SEU-PROJETO.web.app/api
